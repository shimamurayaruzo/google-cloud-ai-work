# 手元開発用。値は各自で決める。リポジトリにもチャットにも本物の値は書かない。
FIRESTORE_DATABASE=develop
GOOGLE_CLOUD_PROJECT=eco-diode-508102-q7
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=true
# Avast 等で TLS が差し替えられる PC
# NODE_EXTRA_CA_CERTS=C:\Users\<you>\AppData\Local\Google\Cloud SDK\ca-bundle.pem

APP_PASSPHRASE=dev-passphrase
INTERNAL_TOKEN=dev-internal-token
DEVICE_TOKENS=hh_main:dev-device-token;hh_demo:dev-demo-token
HOUSEHOLD_ID=hh_main

# 通知（未設定なら台帳に記録するだけで送らない）
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
# SLACK_WEBHOOK_URL=

# tasks: cloud | inline（手元は inline。setTimeout で自分の /internal/* を叩く）
TASKS_MODE=inline
# tts: device | cloud
TTS_MODE=device
# agent: adk | rules（rules は LLM を呼ばない決定論の分類。テストと LLM 障害時の代替）
AGENT_MODE=adk
# 自分の公開 URL（Cloud Tasks のターゲット、OIDC の audience）
# SERVICE_URL=https://hello-google-cloud-xxxx.a.run.app
