{
  "name": "mimamori-agent",
  "version": "0.1.0",
  "private": true,
  "description": "見張らない見守り — 予定と返答で次の声かけを変える在宅介護エージェント（Cloud Run）",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "gcp-build": "npm run build",
    "start": "functions-framework --target=helloHttp --source=dist --port=8080",
    "dev": "tsx watch --env-file-if-exists=.env src/dev.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --env-file-if-exists=.env.test \"test/**/*.test.ts\"",
    "seed:dev": "tsx --env-file-if-exists=.env scripts/seed-dev.ts",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo-history.ts",
    "replay": "tsx --env-file-if-exists=.env scripts/replay.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/functions-framework": "^3.0.0",
    "@google-cloud/tasks": "^5.5.0",
    "@google-cloud/text-to-speech": "^5.8.0",
    "@google/adk": "^2.1.0",
    "@google/genai": "^1.0.0",
    "express": "^4.22.3",
    "google-auth-library": "^9.15.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
